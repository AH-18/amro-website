---
import Layout from '../layouts/Layout.astro';

const highlights = [
	{ title: 'High Accuracy', text: 'Professional surveying methods focused on precise measurements and reliable data.' },
	{ title: 'Engineering Expertise', text: 'Modern technical solutions supporting construction and infrastructure projects.' },
	{ title: 'Reliable Execution', text: 'Committed to quality, efficiency, and professional project delivery.' },
];
---

<Layout
	title="Home | Amro Studio"
	description="Modern showcase website design and development for small businesses."
	path="/"
>
	<section class="page-shell py-14 sm:py-20">
		<div class="glass-card fade-up grid gap-8 p-7 sm:grid-cols-[1.1fr_0.9fr] sm:p-10">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">SURVEYING SOLUTIONS</p>
				<h1 class="mt-3 text-3xl leading-tight sm:text-5xl">Precision. Accuracy. Engineering Excellence.</h1>
				<p class="mt-4 max-w-xl text-[15px] leading-7 text-[var(--muted)] sm:text-base">
					We provide professional surveying and engineering solutions for construction, land development, and infrastructure projects. Focused on precision, reliability, and efficient project execution.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/projects" class="rounded-full bg-[var(--brand)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[var(--brand-dark)]">
						Our Projects
					</a>
					<a href="/contact" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-[var(--brand)] hover:text-[var(--brand-dark)]">
						Start A Project
					</a>
				</div>
			</div>

			<div class="fade-up delay-1 rounded-2xl bg-gradient-to-br from-emerald-700 to-emerald-500 p-6 text-white">
				<p class="text-sm uppercase tracking-[0.2em] text-emerald-100">Our Services Includes</p>
				<ul class="mt-5 space-y-5 text-lg font-semibold leading-8 sm:text-xl sm:leading-9">
					<li>Topographic & land surveys</li>
					<li>Engineering layout planning</li>
					<li>Infrastructure surveying support</li>
					<li>Accurate mapping & plotting</li>
				</ul>
			</div>
		</div>
	</section>
	

	<section class="page-shell pb-14">
		<div class="grid gap-4 sm:grid-cols-3">
			{
				highlights.map((item, idx) => (
					<article class:list={['glass-card p-6', idx === 1 ? 'fade-up delay-1' : idx === 2 ? 'fade-up delay-2' : 'fade-up']}>
						<h2 class="text-lg">{item.title}</h2>
						<p class="mt-2 text-sm leading-7 text-[var(--muted)]">{item.text}</p>
					</article>
				))
			}
		</div>
	</section>
</Layout>
