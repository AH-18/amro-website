---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Showcase Website Build',
    summary: 'A polished multi-page business website with modern content sections.',
  },
  {
    name: 'Performance + SEO Setup',
    summary: 'Fast loading pages, semantic structure, and metadata for search visibility.',
  },
  {
    name: 'Cloudflare Pages Deployment',
    summary: 'Deploy-ready setup focused on low monthly cost and easy future updates.',
  },
];
---

<Layout title="Services | Amro Studio" description="Explore our web design and development services." path="/services">
  <section class="page-shell py-14 sm:py-20">
    <div class="fade-up">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">Services</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">Built around speed, clarity, and business goals.</h1>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        services.map((service, idx) => (
          <article class:list={['glass-card p-6', idx > 0 ? `delay-${idx}` : '', 'fade-up']}>
            <h2 class="text-xl">{service.name}</h2>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{service.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
