---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'مسح الأراضي',
    summary: 'قياس الأراضي الدقيق ومسح الحدود للمشاريع السكنية والتجارية والبنية التحتية.',
  },
  {
    name: 'المسح الهندسي',
    summary: 'دعم المسح الاحترافي لتخطيطات البناء وتخطيط الموقع وتنفيذ المشروع.',
  },
  {
    name: 'رسم الخرائط وتخطيط الموقع',
    summary: 'خدمات رسم خرائط مفصلة وتخطيط تقني مصممة لدعم تطوير المشروع بكفاءة.',
  },
];
---

<Layout title="Services | Amro Studio" description="Explore our web design and development services." path="/services">
  <section class="page-shell py-14 sm:py-20">
    <div class="fade-up">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">الخدمات</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">مبنية على الدقة والموثوقية ومعايير الهندسة المهنية.</h1>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        services.map((service, idx) => (
          <article class:list={['glass-card p-6', idx > 0 ? `delay-${idx}` : '', 'fade-up']}>
            <h2 class="text-xl">{service.name}</h2>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{service.summary}</p>
          </article>
        ))
      }
    </div>

    <img src="/construction-photo.png" alt="Surveying project" class="mt-8 w-full rounded-2xl object-cover" />
  </section>
</Layout>
