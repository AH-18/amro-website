---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Land Surveying',
    summary: 'Accurate land measurements and boundary surveying for residential, commercial, and infrastructure projects.',
  },
  {
    name: 'Engineering Surveying',
    summary: 'Professional surveying support for construction layouts, site planning, and project execution.',
  },
  {
    name: 'Map Plotting & Site Planning',
    summary: 'Detailed mapping and technical planning services designed to support efficient project development.',
  },
];
---

<Layout title="Services | Amro Studio" description="Explore our web design and development services." path="/services">
  <section class="page-shell py-14 sm:py-20">
    <div class="fade-up">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">Services</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">Built on precision, reliability, and professional engineering standards.</h1>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        services.map((service, idx) => (
          <article class:list={['glass-card p-6', idx > 0 ? `delay-${idx}` : '', 'fade-up']}>
            <h2 class="text-xl">{service.name}</h2>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{service.summary}</p>
          </article>
        ))
      }
    </div>

    <img src="/construction-photo.png" alt="Surveying project" class="mt-8 w-full rounded-2xl object-cover" />
  </section>
</Layout>
