---
import Layout from '../layouts/Layout.astro';

const projects = [
  { title: 'موقع العقارات', category: 'الممتلكات', description: 'تجربة صفحة هبوط موجهة نحو التحويل مع أقسام بحث نظيفة.' },
  { title: 'موقع عيادة الأسنان', category: 'الرعاية الصحية', description: 'تصميم الموقع الموجه للخدمات مع مؤشرات الثقة ودعوة لحجز موعد.' },
  { title: 'استوديو الأثاث', category: 'عرض التجارة الإلكترونية', description: 'سرد بصري افتتاحي للأثاث المصنوع يدويا الفاخر.' },
  { title: 'مكتب الهندسة', category: 'الشركات', description: 'موقع ملف تعريف احترافي مع محفظة وصفحات تفاصيل الخدمة.' },
  { title: 'علامة مدرب اللياقة البدنية', category: 'العلامة الشخصية', description: 'تخطيط عالي الطاقة مع شهادات وتمييز الخطط.' },
  { title: 'خدمة المقصف', category: 'الضيافة', description: 'معرض منتجات ملون وتدفق التقاط العملاء الموجه بالأحداث.' },
];
---

<Layout title="Projects | Amro Studio" description="Sample project gallery and showcase work examples." path="/projects">
  <section class="page-shell py-14 sm:py-20">
    <div class="fade-up">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">معرض المشاريع</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">عمل حديث يوازن بين التصميم والأداء.</h1>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((item, idx) => (
          <article class:list={['glass-card overflow-hidden transition hover:-translate-y-1 hover:shadow-lg', idx % 3 === 1 ? 'fade-up delay-1' : idx % 3 === 2 ? 'fade-up delay-2' : 'fade-up']}>
            <div class="h-28 bg-gradient-to-br from-emerald-200 via-emerald-100 to-orange-100"></div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">{item.category}</p>
              <h2 class="mt-2 text-lg">{item.title}</h2>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
