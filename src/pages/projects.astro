---
import Layout from '../layouts/Layout.astro';

const projects = [
  { title: 'Real Estate Landing', category: 'Property', description: 'Conversion-focused landing experience with clean search sections.' },
  { title: 'Dental Clinic Website', category: 'Healthcare', description: 'Service-led site design with trust indicators and appointment CTA.' },
  { title: 'Furniture Studio', category: 'E-commerce Showcase', description: 'Editorial visual storytelling for handcrafted premium furniture.' },
  { title: 'Engineering Office', category: 'Corporate', description: 'Professional profile website with portfolio and service detail pages.' },
  { title: 'Fitness Trainer Brand', category: 'Personal Brand', description: 'High-energy layout with testimonials and plan highlights.' },
  { title: 'Catering Service', category: 'Hospitality', description: 'Colorful product gallery and event-driven lead capture flow.' },
];
---

<Layout title="Projects | Amro Studio" description="Sample project gallery and showcase work examples." path="/projects">
  <section class="page-shell py-14 sm:py-20">
    <div class="fade-up">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">Project Gallery</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">Recent work that balances design and performance.</h1>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((item, idx) => (
          <article class:list={['glass-card overflow-hidden transition hover:-translate-y-1 hover:shadow-lg', idx % 3 === 1 ? 'fade-up delay-1' : idx % 3 === 2 ? 'fade-up delay-2' : 'fade-up']}>
            <div class="h-28 bg-gradient-to-br from-emerald-200 via-emerald-100 to-orange-100"></div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">{item.category}</p>
              <h2 class="mt-2 text-lg">{item.title}</h2>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
