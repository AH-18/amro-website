---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Amro Studio" description="Learn about Amro Studio and our approach." path="/about">
  <section class="page-shell py-14 sm:py-20">
    <div class="glass-card fade-up p-7 sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">من نحن؟</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">فريق احترافي يقدم حلول مسح هندسي دقيقة.</h1>
      <p class="mt-5 max-w-3xl leading-7 text-[var(--muted)]">
        نحن نقدم دعم المسح الاحترافي والرسم الخرائطي والهندسة لمشاريع البناء والبنية التحتية. منهجنا يركز على الدقة التقنية والتنفيذ الموثوق والثقة طويلة الأجل مع العميل.
      </p>
      <img
        src="/about-image.png"
        alt="Surveying and engineering project reference"
        class="mt-6 w-full rounded-2xl border border-emerald-100 object-cover"
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">مؤسسونا</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">أسماء المؤسسين والقصة</p>
        </article>
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">فريقنا</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">عدد الفريق وعدد المجموعات</p>
        </article>
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">المناطق المغطاة</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">قائمة المناطق المغطاة في جميع أنحاء البلاد
        </article>
      </div>
    </div>
  </section>
</Layout>
