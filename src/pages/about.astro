---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Amro Studio" description="Learn about Amro Studio and our approach." path="/about">
  <section class="page-shell py-14 sm:py-20">
    <div class="glass-card fade-up p-7 sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--brand)]">Who we are?</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">A professional team delivering accurate surveying and engineering solutions.</h1>
      <p class="mt-5 max-w-3xl leading-7 text-[var(--muted)]">
        We provide professional surveying, mapping, and engineering support for construction and infrastructure projects. Our approach focuses on technical precision, reliable execution, and long-term client trust.
      </p>
      <img
        src="/about-image.png"
        alt="Surveying and engineering project reference"
        class="mt-6 w-full rounded-2xl border border-emerald-100 object-cover"
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">Our Founders</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Founders names and story</p>
        </article>
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">Our team</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Team number and number of groups</p>
        </article>
        <article class="rounded-xl bg-[var(--surface-soft)] p-5">
          <h2 class="text-lg">Areas Covered</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">List areas covered around the country</p>
        </article>
      </div>
    </div>
  </section>
</Layout>
